sinric_config.h

# Build artifacts
*.bin
*.elf
*.hex

# IDE specific files
.vscode/
.idea/
*.code-workspace

# MacOS files
.DS_Store

# Temporary files
*~
*.swp
*.bak
*.tmp

# Logs
*.log
